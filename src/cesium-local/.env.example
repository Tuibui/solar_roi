# ──────────────────────────────────────────────────────────────────────────────
# Solar ROI Calculator — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.
# ──────────────────────────────────────────────────────────────────────────────

# ── Flask ─────────────────────────────────────────────────────────────────────
# Generate a strong key:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret-key

# ── Database ──────────────────────────────────────────────────────────────────
# Development (SQLite — no setup needed, leave blank to use default)
# DATABASE_URL=sqlite:///backend/solar.db

# Production (PostgreSQL)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME

# ── External APIs ─────────────────────────────────────────────────────────────
# Cesium Ion token — get free token at https://cesium.com/ion/tokens
CESIUM_ION_TOKEN=your-cesium-ion-token-here

# Google Maps API key — needed for address autocomplete & 3D tiles
# Enable: Maps JavaScript API, Places API, Photorealistic 3D Tiles
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# ── Flask CLI ─────────────────────────────────────────────────────────────────
FLASK_APP=backend
FLASK_ENV=development
